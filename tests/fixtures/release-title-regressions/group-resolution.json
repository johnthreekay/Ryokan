      "expect": "SubsPlease",
      "from": "dev 966695a"
    },
    {
      "fn": "rss::feed::extract_group",
      "title": "Show - 01",
      "expect": "",
      "from": "dev 966695a"
    },
    {
      "fn": "rss::feed::extract_group",
      "title": "[unclosed group rest",
      "expect": "",
      "from": "dev 966695a"
    },
    {
      "fn": "rss::feed::extract_group",
      "title": "[漢字組] Show",
      "expect": "漢字組",
      "from": "dev 966695a"
    },
    {
      "fn": "rss::feed::extract_group",
      "title": "[] Show",
      "expect": "",
      "from": "dev 966695a"
    },
    {
      "fn": "rss::feed::extract_resolution",
