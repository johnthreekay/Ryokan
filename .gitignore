/target
/data
/site
*.db
*.db-shm
*.db-wal
*.db-journal
.ryokan-key
.env
.env.*
.venv*/
# The source font scripts/subset-noto-sans-jp.py downloads.
/NotoSansJP*.ttf
/.claude/*
!/.claude/agents/
!/.claude/skills/
# cargo-mutants outputs. The wildcard catches both the canonical
# `mutants.out/` and the timestamped siblings produced when a run is
# preserved before re-running (`mutants.out.pre-pull/` etc.). The
# `mutants-*.log` rule covers the tee'd run logs.
mutants.out*/
mutants-*.log
# scripts/mutants-weekly.sh's default baseline and report paths.
mutants.baseline*.json
mutants-report*.md
